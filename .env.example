# Obligatoire : sans lui, le serveur refuse toutes les requêtes. Donne un accès en lecture seule.
MCP_SECRET=
# Facultatif : donne l'écriture et la publication (devs). Absent = personne n'écrit. Doit différer de MCP_SECRET.
MCP_WRITE_SECRET=
# Jeton Matomo (Paramètres personnels → Jetons d'authentification, « sécurisé uniquement »)
MATOMO_TOKEN=
# Valeurs par défaut ci-dessous
MATOMO_URL=https://stats.beta.gouv.fr
MATOMO_ID_SITE=7
MATOMO_ID_CONTAINER=s4n03ZE1
